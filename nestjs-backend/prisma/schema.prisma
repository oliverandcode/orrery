generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

generator pothos {
    provider    = "prisma-pothos-types"
    prismaUtils = true
}

enum CelestialBodyType {
    LUMINARY
    PLANET
    /** later enums, maybe: 
    *   - ASTEROID
    *   - CALCULATED_POINT (nodes, apogees, etc)
    */
}

enum ClassicalElement {
    AIR
    EARTH
    FIRE
    WATER
}

enum Modality {
    CARDINAL
    FIXED
    MUTABLE
}

enum AspectType {   // ordered by degree
    CONJUNCTION     // 0º       MAJOR
    SEMISEXTILE     // 30º      minor
    SEMISQUARE      // 45º      minor
    SEXTILE         // 60º      MAJOR
    QUINTILE        // 72º      minor
    SQUARE          // 90º      MAJOR
    TRINE           // 120º     MAJOR
    SESQUIQUADRATE  // 135º     minor
    BIQUINTILE      // 144º     minor
    QUINCUNX        // 150º     minor
    OPPOSITION      // 180º     MAJOR
}

model User {
    id                  String  @id @default(cuid())
    email               String  @unique
    name                String?
    password            String?

    // relations
    charts              Chart[]
}

model CelestialBody {
    id          String              @id @default(cuid())
    name        String              @unique
    type        CelestialBodyType
    astroLore   String              // astrological role
    astroData   String              // astronomical description
                                    // (esp. observable characteristics from the surface of TRAPPIST-1e)

    // relations
    transits                Transit[]           // the coordinates at a specific time

    interpretations         Interpretation[]    @relation("BodyInterpretations")
    aspectInterpretations   Interpretation[]    @relation("AspectedBodyInterpretations")

    // domicile                ZodiacSign?         // the sign it governs
}

model ZodiacSign {
    id              String              @id @default(cuid())
    name            String              @unique
    number          Int                 @unique
    symbol          String              // e.g. The Ram, for Aries

    // static and absolute position on the ecliptic plane
    startLongitude  Float               @unique

    astroLore       String              // astrological archetype
    astroData       String              // astronomical description (i.e. star configuration)

    // element         ClassicalElement
    // mode            Modality

    // relations

    transits        Transit[]           // for chart placements

    interpretations Interpretation[]    @relation("SignInterpretations")

    // ruler           CelestialBody       @relation(fields: [rulerId], references: [id])
    // rulerId         String              @unique
}

model House {
    id              String  @id @default(cuid())
    number          Int     @unique
    astroLore       String  // astrological domain

    /** 
    * The angular distance offset of the House's starting longitude
    * on the ecliptic plane from the Ascendant (first house) cusp. 
    * i.e. First House: 0, Second House: 30, Third House = 60, etc
    */
    ascendantOffset Float   @unique

    // relations

    transits        Transit[]

    interpretations Interpretation[]    @relation("HouseInterpretations")
}

model Star {
    id                  String  @id @default(cuid())
    gaiaDr3Id           String  @unique     // Gaia Star Catalogue DR3 ID
    name                String?
    eclipticLongitude   Float
    eclipticLatitude    Float
    apparentMagnitude   Float

    // relations
}

model Chart {
    id                  String      @id @default(cuid())
    dateTime            DateTime
    planetaryLatitude   Float       // chart (birth or event) location
    planetaryLongitude  Float       // on the planet's surface
    createdAt           DateTime    @default(now())
    updatedAt           DateTime    @updatedAt

    ascendantLongitude  Float       // eastern horizon location on the ecliptic

    // relations

    transits            Transit[]

    userId              String
    user                User    @relation(fields: [userId], references: [id])
}

model Transit {
    id                      String          @id @default(cuid())

    // calculated coordinates of celestial body (from the planetary perspective)
    celestialBodyLongitude  Float

    // relations

    // defining relationship (which chart and celestial body)
    chartId                 String
    chart                   Chart           @relation(fields: [chartId], references: [id])

    celestialBodyId         String
    celestialBody           CelestialBody   @relation(fields: [celestialBodyId], references: [id])

    // placements (based on bodyLongitude and ascendantLongitude)
    zodiacSignId            String
    zodiacSign              ZodiacSign      @relation(fields: [zodiacSignId], references: [id])

    houseId                 String
    house                   House           @relation(fields: [houseId], references: [id])

    @@unique([chartId, celestialBodyId])    // a planet can only have one placement per chart
}



model Interpretation { // lookup text
    /** 
    * Each interpretation is defined by relations with 
    * celestial body, sign, and house. 
    * 
    * Aspect interpretations require 2 celestial bodies
    * and the aspect type (calculated elsewehere).
    * e.g. body_1_id, body_2_id, aspect_type_id
    *
    * v0.0: interpretation table exists
    * v0.1: interpretations for sun in each sign (+12)
    * v0.2: interpretations for inner planets (b, c, d) 
    *       in each sign (+36)
    * v0.3: interpretations for outer planets (f, g, h)
    *       in each sign (+36)
    * v0.4: interpretations for sun and planets in each house (+84)
    * beyond: 
    *   - interpretations for sun and planets in each sign/house combo (likely never complete! very large number)
    *   - data structure added for aspect interpretations
    *   - interpretations for major aspects (conjunction, opposition, trine, square, sextile)
    *   - interpretations for minor aspects (quincunx, semi-sextile, semi-square, sesquiquadrate...)
    *   - interpretations for sign-house combos (without a celestial body)
    *
    * 1. Check for all 3 (celestial body, sign, house).
    * 2. Check for celestial body + sign. (MOST COMMON)
    * 3. Check for celestial body + house.
    * 4. Check for sign + house. (UNCOMMON)
    */
    id              String          @id @default(cuid())
    title           String?         // e.g. Sun in Aries (example not applicable to this system, obviously!)
    text            String          // the body text of the interpretation

    // 1. core relations
    celestialBodyId String?
    celestialBody   CelestialBody?  @relation("BodyInterpretations", fields: [celestialBodyId], references: [id])

    zodiacSignId    String?
    zodiacSign      ZodiacSign?     @relation("SignInterpretations", fields: [zodiacSignId], references: [id])

    houseId         String?
    house           House?          @relation("HouseInterpretations", fields: [houseId], references: [id])

    // 2. aspect / complex relationship fields
    aspectType      AspectType

    aspectedBodyId  String?
    aspectedBody    CelestialBody? @relation("AspectedBodyInterpretations", fields: [aspectedBodyId], references: [id])

    @@unique([celestialBodyId, zodiacSignId, houseId, aspectType, aspectedBodyId])
}

/** 
* naming descriptive text in each table
*
* UNIFIED OPTION (all models):  
*   - astro_lore & astro_data 
*           • favorite option
*           • risk of autocomplete confusion
*   - lore_astro & data_astro 
*           • won't get confused with autocomplete
*   - mythic_meaning & space_specs
*           • no autocomplete confusion
*           • also no star trek reference :(
*
* DISTINCT FIELD NAMES
*
* Mythological
*
* celestial bodies  (WHO/WHAT): role
* zodiac signs      (HOW):      archetype
* houses            (WHERE):    domain
*
* Astronomical
*
* bodies:   observable_traits
* signs:    star_configuration
* houses:   no field needed (probably)
*
* bodies:   description of physical characteristics and orbit/behavior, with
*           particular focus on observable traits from TRAPPIST-1e POV
*           - specs, space_specs (specs is short for specifications, which is technically inaccurate)
*           - mechanics (might not cover everything)
*           - observable (might not cover everything)
*           - stats, space_stats, physical_stats (maybe?)
*           - system_stats (maybe?)
*
* signs:    description of the stars/constellations in each ecliptic segment,
*           still figuring this out (have not "drawn" the constellations yet)
*           - specs (technically inaccurate)
*           - stats (this sounds like it's the ecliptic boundaries etc)
*           - data, astro_data
*
* houses:   this is fixed based on planetary position/time of year, so it may 
*           not need an astronomical description. however, the first house 
*           (eastern horizon) still moves through the signs, and maybe this 
*           is where we can explain how TRAPPIST-1e is tidally locked.
*
* what do we call the picture each constellation is supposed to draw?
* i've been considering naming them all after pop stars
*       - symbol*
*       - image
*       - archetype
*/
